# Normalize line endings on checkout to LF for all text files
* text=auto

# Shell scripts must always use LF — CRLF breaks shebang/exec on Linux
*.sh text eol=lf

# Dockerfile and devcontainer config must use LF
Dockerfile text eol=lf
.devcontainer/Dockerfile text eol=lf

# Rust and Python source
*.rs text eol=lf
*.py text eol=lf
*.toml text eol=lf

# Explicitly binary — never munge these
*.png binary
*.jpg binary
*.ico binary
