# ---------------------------------------------------------------------------
# Authentication — choose ONE of the two options below.
# ---------------------------------------------------------------------------

# Option A (recommended): GitHub CLI — no file changes needed.
#   Run `gh auth login` in the terminal (done automatically by the devcontainer
#   setup script).  The pipeline discovers your token via `gh auth token`.

# Option B: Paste a GitHub Personal Access Token or OpenAI API key here.
#   GitHub PAT needs at least the `models:read` scope (Settings → Tokens).
#   For OpenAI, also set LLM_PROVIDER=openai below.
LLM_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# Optional overrides (leave commented to use defaults)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=github_models   # github_models (default) | openai | openai_compatible
# LLM_MODEL=gpt-4o             # model name override
# LLM_BASE_URL=                # required only for openai_compatible (e.g. Ollama)
