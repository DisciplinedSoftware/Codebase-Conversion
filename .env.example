# ---------------------------------------------------------------------------
# Authentication — choose ONE of the two options below.
# ---------------------------------------------------------------------------

# Option A (recommended): GitHub CLI — no file changes needed.
#   Run `gh auth login` in the terminal (done automatically by the devcontainer
#   setup script).  The pipeline discovers your token via `gh auth token`.

# Option B: Paste a GitHub Personal Access Token or OpenAI API key here.
#   GitHub PAT: go to https://github.com/settings/tokens and create a classic PAT.
#   No special scopes are required — any valid GitHub token works with GitHub Models.
LLM_API_KEY=
# LLM_MODEL=gpt-4.1
LLM_MODEL=gpt-4.1-mini
# LLM_MODEL=gpt-4.1-nano
# LLM_MODEL=gpt-4o
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL=gpt-5
# LLM_MODEL=gpt-5-chat
# LLM_MODEL=gpt-5-mini
# LLM_MODEL=gpt-5-nano
# LLM_MODEL=o1
# LLM_MODEL=o1-mini
# LLM_MODEL=o1-preview
# LLM_MODEL=o3
# LLM_MODEL=o3-mini
# LLM_MODEL=o4-mini
# LLM_MODEL=text-embedding-3-large
# LLM_MODEL=text-embedding-3-small
