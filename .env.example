# Optional overrides (leave commented to use defaults)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=github_models   # github_models (default) | openai | openai_compatible
# LLM_MODEL=gpt-4o             # model name override
# LLM_BASE_URL=                # required only for openai_compatible (e.g. Ollama)

