{
  "name": "Fortran-to-Rust Conversion",
  // Build from our Dockerfile so gfortran, f2c, gh, and Rust are pre-installed.
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  // Run as the non-root "vscode" user that the base image ships with.
  "remoteUser": "vscode",
  // Mount the workspace and carry Cargo's registry cache across rebuilds.
  "mounts": [
    "source=codebase-conversion-cargo-cache,target=/home/vscode/.cargo/registry,type=volume",
    "source=codebase-conversion-cargo-git,target=/home/vscode/.cargo/git,type=volume"
  ],
  // After the container is created:
  //   1. Upgrade pip and install the Python package in editable mode.
  //   2. Run the interactive auth-setup script so the user can choose between
  //      `gh auth login` and a .env file for LLM API access.
  "postCreateCommand": "/home/vscode/.venv/bin/pip install --upgrade pip && /home/vscode/.venv/bin/pip install --no-cache-dir -e . 2>/dev/null || true && bash scripts/setup_auth.sh",

  // Keep a copy of the Rust toolchain fresh on every rebuild.
  "postStartCommand": "rustup update stable --no-self-update 2>/dev/null || true",
  // VS Code / GitHub Codespaces extensions
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "serayuzgur.crates",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        "python.formatting.provider": "none",
        "[python]": {
          "editor.defaultFormatter": "ms-python.python"
        },
        "rust-analyzer.cargo.features": "all",
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  // Forward no ports by default; add entries here if you add a web UI later.
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "Report Server",
      "onAutoForward": "notify"
    }
  },
  // Environment variables available inside the container.
  // Set LLM_API_KEY via a .env file or a Codespaces secret — never hardcode.
  "containerEnv": {
    "LLM_PROVIDER": "copilot"
  }
}